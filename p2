	snipebotEnabled = state
end)

-- 3. Fling
local flingEnabled = false
createToggle("Fling", function(state)
	flingEnabled = state
	if state then
		task.spawn(function()
			while flingEnabled do
				RunService.Heartbeat:Wait()
				pcall(function()
					local char = LocalPlayer.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					if hrp then
						local vel = hrp.Velocity
						hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
						RunService.RenderStepped:Wait()
						hrp.Velocity = vel
					end
				end)
			end
		end)
	end
end)

-- 4. Magnet (Липучка)
local magnetEnabled = false
local attachedPlayers = {}

createToggle("Magnet (Touch)", function(state)
	magnetEnabled = state
	if not state then
		attachedPlayers = {}
	end
end)

-- 5. Freeze Touch
local freezeTouchEnabled = false
local frozenPlayers = {}

createToggle("Freeze Touch", function(state)
	freezeTouchEnabled = state
	if not state then
		for plr, _ in pairs(frozenPlayers) do
			if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
				plr.Character.HumanoidRootPart.Anchored = false
			end
		end
		frozenPlayers = {}
	end
end)

-- 6. Camera Shaker
local cameraShakerEnabled = false
createToggle("Camera Shaker Aura", function(state)
	cameraShakerEnabled = state
end)

-- === ОБРАБОТЧИК КАСАНИЙ (TOUCH EVENT) ===
local function setupTouch(char)
	if not char then return end
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	if not hrp then return end

	hrp.Touched:Connect(function(hit)
		local targetChar = hit.Parent
		if not targetChar then return end
		local targetPlr = Players:GetPlayerFromCharacter(targetChar)

		if targetPlr and targetPlr ~= LocalPlayer then
			-- Магнит
			if magnetEnabled then
				if not table.find(attachedPlayers, targetPlr) then
					table.insert(attachedPlayers, targetPlr)
				end
			end

			-- Фриз при касании
			if freezeTouchEnabled then
				local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
				if targetHrp then
					targetHrp.Anchored = true
					frozenPlayers[targetPlr] = true
				end
			end
		end
	end)
end

if LocalPlayer.Character then setupTouch(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupTouch)

-- === ОСНОВНОЙ ЦИКЛ РЕНДЕРА ===
RunService.RenderStepped:Connect(function()
	local myChar = LocalPlayer.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

	-- Удержание скорости
	if speedEnabled and myChar then
		local hum = myChar:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 32 end
	end

	-- Snipebot (Вращение)
	if snipebotEnabled and myHrp then
		myHrp.CFrame = myHrp.CFrame * CFrame.Angles(0, math.rad(180), 0)
	end

	-- Логика Магнита (Удержание прилипших игроков)
	if magnetEnabled and myHrp then
		for i = #attachedPlayers, 1, -1 do
			local p = attachedPlayers[i]
			if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				tHrp.CFrame = myHrp.CFrame * CFrame.new((i % 2 == 0 and 2.5 or -2.5), 0, math.floor(i / 2) * 2 + 2)
			else
				table.remove(attachedPlayers, i)
			end
		end
	end

	-- Логика Camera Shaker (Аура тряски вокруг)
	if cameraShakerEnabled and myHrp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				local dist = (myHrp.Position - tHrp.Position).Magnitude
				if dist <= 20 then
					tHrp.CFrame = tHrp.CFrame * CFrame.Angles(
						math.rad(math.random(-15, 15)),
						math.rad(math.random(-15, 15)),
						math.rad(math.random(-15, 15))
					)
				end
			end
		end
	end
end)
