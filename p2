-- Click TP
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe or not states.clickTP then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or input.UserInputType == Enum.UserInputType.Touch then
			local mouse = LocalPlayer:GetMouse()
			if mouse and mouse.Hit and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
			end
		end
	end
end)

-- === ОБРАБОТКА КАСАНИЙ ===
local function setupTouch(char)
	if not char then return end
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	if not hrp then return end

	hrp.Touched:Connect(function(hit)
		local targetChar = hit.Parent
		if not targetChar then return end
		local targetPlr = Players:GetPlayerFromCharacter(targetChar)

		if targetPlr and targetPlr ~= LocalPlayer then
			local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")

			-- Dismantle (Разлом суставов)
			if states.dismantle and targetChar then
				for _, part in ipairs(targetChar:GetChildren()) do
					if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
						pcall(function()
							part:BreakJoints()
							part.Velocity = Vector3.new(math.random(-100, 100), 200, math.random(-100, 100))
						end)
					end
				end
			end

			-- Magnet
			if states.magnet and not table.find(attachedPlayers, targetPlr) then
				table.insert(attachedPlayers, targetPlr)
			end

			-- Freeze Touch
			if states.freezeTouch and targetHrp then
				targetHrp.Anchored = true
				frozenPlayers[targetPlr] = true
			end

			-- Heavy Mass
			if states.heavyMass then
				local hum = targetChar:FindFirstChildOfClass("Humanoid")
				if hum then
					hum.WalkSpeed = 0
					hum.JumpPower = 0
				end
			end

			-- Dance Disease
			if states.danceDisease then
				local hum = targetChar:FindFirstChildOfClass("Humanoid")
				if hum then
					local anim = Instance.new("Animation")
					anim.AnimationId = "rbxassetid://3337781730"
					local track = hum:LoadAnimation(anim)
					track:Play()
				end
			end

			-- Seizure
			if states.seizure and targetHrp then
				targetHrp.CFrame = targetHrp.CFrame * CFrame.Angles(math.rad(math.random(-90, 90)), math.rad(math.random(-90, 90)), 0)
			end
		end
	end)
end

if LocalPlayer.Character then setupTouch(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupTouch)

-- === ОСНОВНОЙ ЦИКЛ ОБНОВЛЕНИЯ ===
RunService.RenderStepped:Connect(function()
	local myChar = LocalPlayer.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local hue = (tick() % 4) / 4
	local rainbowColor = Color3.fromHSV(hue, 1, 1)

	-- Speed 2x
	if states.speed and myChar then
		local hum = myChar:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 32 end
	end

	-- Rainbow Aura
	if states.rainbowAura and myChar then
		local hl = myChar:FindFirstChild("SelfRainbowHighlight")
		if not hl then
			hl = Instance.new("Highlight")
			hl.Name = "SelfRainbowHighlight"
			hl.FillTransparency = 0.5
			hl.OutlineTransparency = 0
			hl.Parent = myChar
		end
		hl.FillColor = rainbowColor
		hl.OutlineColor = Color3.new(1, 1, 1)
	end

	-- RGB Disco World
	if states.rgbWorld then
		Lighting.Ambient = rainbowColor
	end

	-- Head Spin / Lag
	if states.headSpin and myChar then
		local head = myChar:FindFirstChild("Head")
		if head then
			head.CFrame = head.CFrame * CFrame.Angles(0, math.rad(45), 0)
		end
	end

	-- Tornado Aura (Смерч)
	if states.tornado and myHrp then
		local angle = tick() * 8
		for i, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				if (myHrp.Position - tHrp.Position).Magnitude <= 25 then
					local radius = 8
					local offset = Vector3.new(math.cos(angle + i) * radius, 2, math.sin(angle + i) * radius)
					tHrp.CFrame = myHrp.CFrame * CFrame.new(offset)
				end
			end
		end
	end

	-- Snipebot (Spin)
	if states.snipebot and myHrp then
		myHrp.CFrame = myHrp.CFrame * CFrame.Angles(0, math.rad(180), 0)
	end

	-- Magnet
	if states.magnet and myHrp then
		for i = #attachedPlayers, 1, -1 do
			local p = attachedPlayers[i]
			if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				tHrp.CFrame = myHrp.CFrame * CFrame.new((i % 2 == 0 and 2.5 or -2.5), 0, math.floor(i / 2) * 2 + 2)
			else
				table.remove(attachedPlayers, i)
			end
		end
	end

	-- Camera Shaker
	if states.cameraShaker and myHrp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				if (myHrp.Position - tHrp.Position).Magnitude <= 20 then
					tHrp.CFrame = tHrp.CFrame * CFrame.Angles(
						math.rad(math.random(-15, 15)),
						math.rad(math.random(-15, 15)),
						math.rad(math.random(-15, 15))
					)
				end
			end
		end
	end

	-- Reverse Fling Aura
	if states.reverseFling and myHrp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				if (myHrp.Position - tHrp.Position).Magnitude <= 15 then
					pcall(function()
						local dir = (tHrp.Position - myHrp.Position).Unit
						tHrp.AssemblyLinearVelocity = dir * 10000 + Vector3.new(0, 5000, 0)
					end)
				end
			end
		end
	end

	-- ESP Boxes
	if states.esp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local box = espBoxes[p]
				if not box then
					box = Instance.new("Highlight")
					box.Name = "ESP_Highlight"
					box.FillColor = Color3.fromRGB(0, 230, 255)
					box.FillTransparency = 0.6
					box.OutlineColor = Color3.fromRGB(255, 255, 255)
					box.OutlineTransparency = 0
					box.Parent = p.Character
					espBoxes[p] = box
				end
			end
		end
	end
end)
