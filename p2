local function createToggle(titleText, callback)
	local toggle = Instance.new("TextButton")
	toggle.Parent = Container
	toggle.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
	toggle.Size = UDim2.new(1, 0, 0, 42)
	toggle.Text = ""
	round(toggle, 10)
	local strk = stroke(toggle, Color3.fromRGB(35, 35, 48), 1)

	local title = Instance.new("TextLabel")
