local function getBoundingBox(char)
	local camera = workspace.CurrentCamera
	if not char or not camera then return nil, false end

	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	local onScreen = false

	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			local cframe, size = part.CFrame, part.Size
			local corners = {
				cframe * Vector3.new(-size.X/2, -size.Y/2, -size.Z/2),
				cframe * Vector3.new(size.X/2, -size.Y/2, -size.Z/2),
				cframe * Vector3.new(-size.X/2, size.Y/2, -size.Z/2),
				cframe * Vector3.new(size.X/2, size.Y/2, -size.Z/2),
				cframe * Vector3.new(-size.X/2, -size.Y/2, size.Z/2),
				cframe * Vector3.new(size.X/2, -size.Y/2, size.Z/2),
				cframe * Vector3.new(-size.X/2, size.Y/2, size.Z/2),
				cframe * Vector3.new(size.X/2, size.Y/2, size.Z/2)
			}

			for _, corner in ipairs(corners) do
				local screenPos, isVisible = camera:WorldToViewportPoint(corner)
				if isVisible then onScreen = true end
				minX = math.min(minX, screenPos.X)
				minY = math.min(minY, screenPos.Y)
				maxX = math.max(maxX, screenPos.X)
				maxY = math.max(maxY, screenPos.Y)
			end
		end
	end

	if onScreen then
		return {
			X = minX,
			Y = minY,
			Width = maxX - minX,
			Height = maxY - minY
		}, true
	end
	return nil, false
end

local function setupTouch(char)
	if not char then return end
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	if not hrp then return end

	hrp.Touched:Connect(function(hit)
		local targetChar = hit.Parent
		if not targetChar then return end
		local targetPlr = Players:GetPlayerFromCharacter(targetChar)

		if targetPlr and targetPlr ~= LocalPlayer then
			local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")

			if states.seatTrap and targetHrp then
				pcall(function()
					local seat = Instance.new("Seat")
					seat.Size = Vector3.new(1, 1, 1)
					seat.Transparency = 1
					seat.Anchored = false
					seat.CFrame = targetHrp.CFrame + Vector3.new(0, 3, 0)
					seat.Parent = workspace
					local weld = Instance.new("Weld")
					weld.Part0 = seat
					weld.Part1 = targetHrp
					weld.C0 = CFrame.new(0, 0, 0)
					weld.Parent = seat
					task.delay(3, function()
						pcall(function() seat:Destroy() end)
					end)
				end)
			end
		end
	end)
end

if LocalPlayer.Character then setupTouch(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(char)
	setupTouch(char)
	task.wait(0.5)
	if states.invisibleHead then
		local head = char:FindFirstChild("Head")
		if head then
			local neck = head:FindFirstChild("Neck") or (char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Neck")) or (char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Neck"))
			if neck then neck.Enabled = false end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	local myChar = LocalPlayer.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

	if states.speed2x and myChar then
		local hum = myChar:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 32 end
	end

	if states.spin360 and myHrp then
		local cam = workspace.CurrentCamera
		if cam then
			local lookVec = cam.CFrame.LookVector
			local targetAngle = math.atan2(-lookVec.Z, lookVec.X) + math.rad(math.random(0, 360))
			myHrp.CFrame = CFrame.new(myHrp.Position) * CFrame.Angles(0, targetAngle, 0)
		end
	end

	if states.wallWalk and myHrp then
		local raycastParams = RaycastParams.new()
		raycastParams.FilterDescendantsInstances = {myChar}
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude

		local rayResult = workspace:Raycast(myHrp.Position, myHrp.CFrame.LookVector * 3, raycastParams)
		if rayResult then
			myHrp.AssemblyLinearVelocity = Vector3.new(myHrp.AssemblyLinearVelocity.X, 30, myHrp.AssemblyLinearVelocity.Z)
		end
	end

	if states.cameraShaker and myHrp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				if (myHrp.Position - tHrp.Position).Magnitude <= 20 then
					tHrp.CFrame = tHrp.CFrame * CFrame.Angles(
						math.rad(math.random(-15, 15)),
						math.rad(math.random(-15, 15)),
						math.rad(math.random(-15, 15))
					)
				end
			end
		end
	end

	espFolder:ClearAllChildren()
	if states.boxEsp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				local box, visible = getBoundingBox(p.Character)
				if visible and box then
					local boxGui = Instance.new("Frame")
					boxGui.BackgroundTransparency = 1
					boxGui.Position = UDim2.new(0, box.X, 0, box.Y)
					boxGui.Size = UDim2.new(0, box.Width, 0, box.Height)
					boxGui.Parent = espFolder
					
					stroke(boxGui, Color3.fromRGB(0, 255, 102), 1.5)

					local nameLabel = Instance.new("TextLabel")
					nameLabel.Parent = boxGui
					nameLabel.BackgroundTransparency = 1
					nameLabel.Position = UDim2.new(0, 0, 0, -18)
					nameLabel.Size = UDim2.new(1, 0, 0, 15)
					nameLabel.Text = p.Name
					nameLabel.TextColor3 = Color3.fromRGB(0, 255, 102)
					nameLabel.TextSize = 11
					nameLabel.Font = Enum.Font.GothamBold
				end
			end
		end
	end
end)
