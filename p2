local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

if not LocalPlayer then return end

pcall(function()
	local oldGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("FlingControlGui")
	if oldGui then oldGui:Destroy() end
end)

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FlingControlGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local function round(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = obj
end

local function stroke(obj, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Parent = obj
	return s
end

local BtnFling = Instance.new("TextButton")
BtnFling.Name = "BtnFling"
BtnFling.Parent = ScreenGui
BtnFling.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
BtnFling.Position = UDim2.new(0.05, 0, 0.4, 0)
BtnFling.Size = UDim2.new(0, 60, 0, 45)
BtnFling.Text = "Fling"
BtnFling.TextColor3 = Color3.fromRGB(255, 255, 255)
BtnFling.TextSize = 16
BtnFling.Font = Enum.Font.GothamBold
BtnFling.Active = true
BtnFling.Draggable = true
round(BtnFling, 8)
stroke(BtnFling, Color3.fromRGB(60, 60, 60), 1)

local isFlingMode = false

BtnFling.MouseButton1Click:Connect(function()
	isFlingMode = not isFlingMode
	if isFlingMode then
		BtnFling.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
	else
		BtnFling.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if isFlingMode then
			local mouse = LocalPlayer:GetMouse()
			local target = mouse.Target

			if target and target.Parent then
				local char = target.Parent
				if not char:FindFirstChild("Humanoid") then
					char = char.Parent
				end

				local plr = Players:GetPlayerFromCharacter(char)
				if plr and plr ~= LocalPlayer and char:FindFirstChild("HumanoidRootPart") then
					local hrp = char:FindFirstChild("HumanoidRootPart")
					
					isFlingMode = false
					BtnFling.BackgroundColor3 = Color3.fromRGB(20, 20, 20)

					task.spawn(function()
						local startTime = tick()
						while tick() - startTime < 0.3 do
							if hrp and hrp.Parent then
								hrp.AssemblyLinearVelocity = Vector3.new(
									math.random(1000, 3000), 
									5000, 
									math.random(1000, 3000)
								)
								hrp.AssemblyAngularVelocity = Vector3.new(
									math.random(1000, 5000), 
									math.random(1000, 5000), 
									math.random(1000, 5000)
								)
							end
							task.wait()
						end
					end)
				end
			end
		end
	end
end)
