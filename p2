local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

if not LocalPlayer then return end

pcall(function()
	local oldGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("GrabControlGui")
	if oldGui then oldGui:Destroy() end
end)

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "GrabControlGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local function round(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = obj
end

local function stroke(obj, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Parent = obj
	return s
end

local BtnV = Instance.new("TextButton")
BtnV.Name = "BtnV"
BtnV.Parent = ScreenGui
BtnV.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
BtnV.Position = UDim2.new(0.05, 0, 0.4, 0)
BtnV.Size = UDim2.new(0, 45, 0, 45)
BtnV.Text = "V"
BtnV.TextColor3 = Color3.fromRGB(255, 255, 255)
BtnV.TextSize = 18
BtnV.Font = Enum.Font.GothamBold
BtnV.Active = true
BtnV.Draggable = true
round(BtnV, 8)
stroke(BtnV, Color3.fromRGB(60, 60, 60), 1)

local BtnL = Instance.new("TextButton")
BtnL.Name = "BtnL"
BtnL.Parent = ScreenGui
BtnL.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
BtnL.Position = UDim2.new(0.05, 0, 0.5, 0)
BtnL.Size = UDim2.new(0, 45, 0, 45)
BtnL.Text = "L"
BtnL.TextColor3 = Color3.fromRGB(255, 255, 255)
BtnL.TextSize = 18
BtnL.Font = Enum.Font.GothamBold
BtnL.Active = true
BtnL.Draggable = true
round(BtnL, 8)
stroke(BtnL, Color3.fromRGB(60, 60, 60), 1)

local targetCharacter = nil
local grabDistance = 15
local isSelectMode = false
local grabConnection = nil

local function releaseTarget()
	if grabConnection then
		grabConnection:Disconnect()
		grabConnection = nil
	end
	if targetCharacter then
		pcall(function()
			local hrp = targetCharacter:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.AssemblyLinearVelocity = Vector3.new(0, -5, 0)
			end
		end)
	end
	targetCharacter = nil
	isSelectMode = false
	BtnV.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
end

BtnV.MouseButton1Click:Connect(function()
	if targetCharacter then
		releaseTarget()
	else
		isSelectMode = not isSelectMode
		if isSelectMode then
			BtnV.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
		else
			BtnV.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		end
	end
end)

BtnL.MouseButton1Click:Connect(function()
	releaseTarget()
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if isSelectMode and not targetCharacter then
			local mouse = LocalPlayer:GetMouse()
			local target = mouse.Target

			if target and target.Parent then
				local char = target.Parent
				if not char:FindFirstChild("Humanoid") then
					char = char.Parent
				end

				local plr = Players:GetPlayerFromCharacter(char)
				if plr and plr ~= LocalPlayer and char:FindFirstChild("HumanoidRootPart") then
					targetCharacter = char
					isSelectMode = false
					BtnV.BackgroundColor3 = Color3.fromRGB(0, 180, 80)

					local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					local targetHrp = targetCharacter:FindFirstChild("HumanoidRootPart")

					if myHrp and targetHrp then
						grabDistance = (targetHrp.Position - myHrp.Position).Magnitude
					else
						grabDistance = 15
					end

					grabConnection = RunService.RenderStepped:Connect(function()
						if targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart") then
							local cam = workspace.CurrentCamera
							if cam then
								local mousePos = mouse.Hit.Position
								local targetHrp = targetCharacter:FindFirstChild("HumanoidRootPart")
								targetHrp.CFrame = CFrame.new(mousePos)
								targetHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
								targetHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
							end
						else
							releaseTarget()
						end
					end)
				end
			end
		end
	end
end)
