UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe or not states.clickTP then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or input.UserInputType == Enum.UserInputType.Touch then
			local mouse = LocalPlayer:GetMouse()
			if mouse and mouse.Hit and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
			end
		end
	end
end)

local function setupTouch(char)
	if not char then return end
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	if not hrp then return end

	hrp.Touched:Connect(function(hit)
		local targetChar = hit.Parent
		if not targetChar then return end
		local targetPlr = Players:GetPlayerFromCharacter(targetChar)

		if targetPlr and targetPlr ~= LocalPlayer then
			local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")

			if states.freezeScreen and targetHrp then
				pcall(function()
					targetHrp.CFrame = CFrame.new(0, -99999, 0)
					targetHrp.Anchored = true
				end)
			end

			if states.seatTrap and targetHrp then
				pcall(function()
					local seat = Instance.new("Seat")
					seat.Size = Vector3.new(1, 1, 1)
					seat.Transparency = 1
					seat.Anchored = false
					seat.CFrame = targetHrp.CFrame + Vector3.new(0, 3, 0)
					seat.Parent = workspace
					local weld = Instance.new("Weld")
					weld.Part0 = seat
					weld.Part1 = targetHrp
					weld.C0 = CFrame.new(0, 0, 0)
					weld.Parent = seat
					task.delay(3, function()
						pcall(function() seat:Destroy() end)
					end)
				end)
			end

			if states.dismantle and targetChar then
				for _, part in ipairs(targetChar:GetChildren()) do
					if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
						pcall(function()
							part:BreakJoints()
							part.AssemblyLinearVelocity = Vector3.new(math.random(-150, 150), 300, math.random(-150, 150))
						end)
					end
				end
			end

			if states.magnet and not table.find(attachedPlayers, targetPlr) then
				table.insert(attachedPlayers, targetPlr)
			end

			if states.freezeTouch and targetHrp then
				targetHrp.Anchored = true
				frozenPlayers[targetPlr] = true
			end

			if states.heavyMass then
				local hum = targetChar:FindFirstChildOfClass("Humanoid")
				if hum then
					hum.WalkSpeed = 0
					hum.JumpPower = 0
				end
			end

			if states.danceDisease then
				local hum = targetChar:FindFirstChildOfClass("Humanoid")
				if hum then
					local anim = Instance.new("Animation")
					anim.AnimationId = "rbxassetid://3337781730"
					local track = hum:LoadAnimation(anim)
					track:Play()
				end
			end

			if states.seizure and targetHrp then
				targetHrp.CFrame = targetHrp.CFrame * CFrame.Angles(math.rad(math.random(-90, 90)), math.rad(math.random(-90, 90)), 0)
			end
		end
	end)
end

