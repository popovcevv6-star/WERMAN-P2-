RunService.RenderStepped:Connect(function()
	local myChar = LocalPlayer.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

	if states.antiFling and myHrp then
		myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end

	if states.speed and myChar then
		local hum = myChar:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 32 end
	end

	if states.extremeSpin and myHrp then
		local cam = workspace.CurrentCamera
		if cam then
			local lookVec = cam.CFrame.LookVector
			local targetAngle = math.atan2(-lookVec.Z, lookVec.X) + math.rad(math.random(0, 360))
			myHrp.CFrame = CFrame.new(myHrp.Position) * CFrame.Angles(0, targetAngle, 0)
		end
	end

	if states.timeStop and myHrp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				local tHum = p.Character:FindFirstChildOfClass("Humanoid")
				local dist = (myHrp.Position - tHrp.Position).Magnitude

				if dist <= 80 then
					pcall(function()
						tHrp.Anchored = true
						if tHum then tHum.WalkSpeed = 0 end
					end)
				end
			end
		end
	end

	if states.physicsTornado and myHrp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				local tHum = p.Character:FindFirstChildOfClass("Humanoid")
				local dist = (myHrp.Position - tHrp.Position).Magnitude

				if dist <= 30 then
					pcall(function()
						if tHum then
							tHum:ChangeState(Enum.HumanoidStateType.Physics)
						end
						local dir = (myHrp.Position - tHrp.Position).Unit
						local tangent = Vector3.new(-dir.Z, 0, dir.X)
						
						tHrp.AssemblyLinearVelocity = (tangent * 1200) + (dir * 300) + Vector3.new(0, 500, 0)
						tHrp.AssemblyAngularVelocity = Vector3.new(4000, 4000, 4000)
					end)
				end
			end
		end
	end

	if states.headSpin and myChar then
		local head = myChar:FindFirstChild("Head")
		if head then
			head.CFrame = head.CFrame * CFrame.Angles(0, math.rad(45), 0)
		end
	end

	if states.spinbot and myHrp then
		myHrp.CFrame = myHrp.CFrame * CFrame.Angles(0, math.rad(180), 0)
	end

	if states.magnet and myHrp then
		for i = #attachedPlayers, 1, -1 do
			local p = attachedPlayers[i]
			if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				tHrp.CFrame = myHrp.CFrame * CFrame.new((i % 2 == 0 and 2.5 or -2.5), 0, math.floor(i / 2) * 2 + 2)
			else
				table.remove(attachedPlayers, i)
			end
		end
	end

	if states.cameraShaker and myHrp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				if (myHrp.Position - tHrp.Position).Magnitude <= 20 then
					tHrp.CFrame = tHrp.CFrame * CFrame.Angles(
						math.rad(math.random(-15, 15)),
						math.rad(math.random(-15, 15)),
						math.rad(math.random(-15, 15))
					)
				end
			end
		end
	end

	if states.reverseFling and myHrp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = p.Character.HumanoidRootPart
				if (myHrp.Position - tHrp.Position).Magnitude <= 15 then
					pcall(function()
						local dir = (tHrp.Position - myHrp.Position).Unit
						tHrp.AssemblyLinearVelocity = dir * 10000 + Vector3.new(0, 5000, 0)
					end)
				end
			end
		end
	end

	if states.esp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local box = espBoxes[p]
				if not box then
					box = Instance.new("Highlight")
					box.Name = "ESP_Highlight"
					box.FillColor = Color3.fromRGB(0, 230, 255)
					box.FillTransparency = 0.7
					box.OutlineColor = Color3.fromRGB(255, 255, 255)
					box.OutlineTransparency = 0
					box.Parent = p.Character
					espBoxes[p] = box
				end
			end
		end
	end
end)
