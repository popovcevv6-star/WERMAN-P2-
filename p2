	title.Size = UDim2.new(0, 220, 1, 0)
	title.Text = titleText
	title.TextColor3 = Color3.fromRGB(220, 220, 240)
	title.TextSize = 13
	title.Font = Enum.Font.GothamSemibold
	title.TextXAlignment = Enum.TextXAlignment.Left

	local indicator = Instance.new("Frame")
	indicator.Parent = toggle
	indicator.AnchorPoint = Vector2.new(1, 0.5)
	indicator.Position = UDim2.new(1, -12, 0.5, 0)
	indicator.Size = UDim2.new(0, 38, 0, 20)
	indicator.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
	round(indicator, 10)

	local circle = Instance.new("Frame")
	circle.Parent = indicator
	circle.AnchorPoint = Vector2.new(0, 0.5)
	circle.Position = UDim2.new(0, 3, 0.5, 0)
	circle.Size = UDim2.new(0, 14, 0, 14)
	circle.BackgroundColor3 = Color3.fromRGB(150, 150, 170)
	round(circle, 7)

	local state = false
	toggle.MouseButton1Click:Connect(function()
		state = not state
		if state then
			indicator.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
			circle.Position = UDim2.new(1, -17, 0.5, 0)
			circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			strk.Color = Color3.fromRGB(0, 150, 200)
		else
			indicator.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
			circle.Position = UDim2.new(0, 3, 0.5, 0)
			circle.BackgroundColor3 = Color3.fromRGB(150, 150, 170)
			strk.Color = Color3.fromRGB(35, 35, 48)
		end
		pcall(function() callback(state) end)
	end)
end

